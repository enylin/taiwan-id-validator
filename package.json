{
  "name": "taiwan-id-validator",
  "version": "2.0.0-0",
  "description": "中華民國統一編號、外來人口統一證號、國民身分證統一編號、自然人憑證及電子發票相關號碼驗證",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "unpkg": "./dist/index.global.min.js",
  "jsdelivr": "./dist/index.global.min.js",
  "files": [
    "dist",
    "docs/specification-sources.md",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "packageManager": "npm@11.19.1",
  "scripts": {
    "build": "vite build && vite build --config vite.browser.config.ts",
    "check-types": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\" \"*.config.ts\"",
    "format": "prettier --write \"src/**/*.ts\" \"*.config.{js,ts}\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"*.config.{js,ts}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "check": "npm run check-types && npm run lint && npm run format:check && npm run test",
    "prepack": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/enylin/taiwan-id-validator.git"
  },
  "bugs": {
    "url": "https://github.com/enylin/taiwan-id-validator/issues"
  },
  "homepage": "https://github.com/enylin/taiwan-id-validator#readme",
  "keywords": [
    "中華民國",
    "台灣",
    "Taiwan",
    "TypeScript",
    "電子發票",
    "統一編號",
    "身分證字號",
    "外來人口統一證號",
    "自然人憑證",
    "手機條碼",
    "捐贈碼",
    "愛心碼",
    "ARC",
    "APRC"
  ],
  "author": {
    "name": "enylin",
    "email": "sean.enylin@gmail.com"
  },
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@microsoft/api-extractor": "^7.59.0",
    "@types/node": "^22.20.2",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10.10.0",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0",
    "unplugin-dts": "^1.1.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
