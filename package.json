{
  "name": "taiwan-id-validator",
  "version": "2.0.0",
  "description": "中華民國統一編號、外來人口統一證號、國民身分證統一編號、自然人憑證及電子發票相關號碼驗證",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "unpkg": "./dist/index.global.min.js",
  "jsdelivr": "./dist/index.global.min.js",
  "files": [
    "dist",
    "docs/specification-sources.md",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "packageManager": "npm@12.0.2",
  "scripts": {
    "build": "vite build && npm run build:types && npm run build:cjs-types && vite build --config vite.browser.config.ts",
    "build:types": "tsc6 --project tsconfig.build.json",
    "build:cjs-types": "tsc6 --project tsconfig.build.cjs.json && node scripts/prepare-cjs-declarations.mjs",
    "check-types": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\" \"*.config.ts\"",
    "format": "prettier --write \"src/**/*.ts\" \"*.config.{js,ts}\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"*.config.{js,ts}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:regression": "npm run build && npm run test:regression:built",
    "test:regression:built": "node scripts/test-regression.mjs",
    "test:package": "npm run build && node scripts/test-package.mjs && npm run test:regression:built",
    "test:attw": "attw --pack .",
    "check": "npm run check-types && npm run lint && npm run format:check && npm run test",
    "prepack": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/enylin/taiwan-id-validator.git"
  },
  "bugs": {
    "url": "https://github.com/enylin/taiwan-id-validator/issues"
  },
  "homepage": "https://github.com/enylin/taiwan-id-validator#readme",
  "keywords": [
    "中華民國",
    "台灣",
    "Taiwan",
    "TypeScript",
    "電子發票",
    "統一編號",
    "身分證字號",
    "外來人口統一證號",
    "自然人憑證",
    "手機條碼",
    "捐贈碼",
    "愛心碼",
    "ARC",
    "APRC"
  ],
  "author": {
    "name": "enylin",
    "email": "sean.enylin@gmail.com"
  },
  "license": "MIT",
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.4",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10.10.0",
    "prettier": "^3.9.6",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
}
